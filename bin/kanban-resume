#!/usr/bin/env bash
# Resume a blocked card: append the user's answer to the body, unblock, and
# return the card to todo so the next pick will surface it.
#
# Usage:
#   kanban-resume <card-id> "<answer text>" [--project-root DIR]

set -euo pipefail

CARD_ID=""
ANSWER=""
PROJECT_ROOT="."

while [ $# -gt 0 ]; do
  case "$1" in
    --project-root) PROJECT_ROOT="$2"; shift 2 ;;
    -h|--help) sed -n '2,9p' "$0"; exit 0 ;;
    *)
      if [ -z "$CARD_ID" ]; then CARD_ID="$1"
      elif [ -z "$ANSWER" ]; then ANSWER="$1"
      else printf 'Unexpected arg: %s\n' "$1" >&2; exit 2
      fi
      shift ;;
  esac
done

[ -n "$CARD_ID" ] || { printf 'card-id required\n' >&2; exit 2; }
[ -n "$ANSWER" ] || { printf 'answer text required\n' >&2; exit 2; }
command -v kanban-md >/dev/null 2>&1 || { printf 'kanban-md not on PATH\n' >&2; exit 1; }

script_dir="$(cd "$(dirname "$0")" && pwd)"
board=$("${script_dir}/kanban-active-board" --project-root "$PROJECT_ROOT")

# Resolve agent name for the claim we need to grab in order to edit a card
# that's in a require_claim column (review).
config="${PROJECT_ROOT}/.superpowers-kanban/config.json"
AGENT="claude"
if [ -f "$config" ]; then
  AGENT=$(python3 -c "import json,sys; c=json.load(open(sys.argv[1])); print(c.get('agent_name') or 'claude')" "$config")
fi

# Format the answer block. Timestamp helps the next subagent see when this came in.
ts=$(date -u +'%Y-%m-%dT%H:%M:%SZ')
answer_block=$(printf '\n\n## Answer (%s)\n\n%s\n' "$ts" "$ANSWER")

# 1. Claim, unblock, and append the answer in a single edit call.
#    (The card is in `review` which has require_claim=true.)
kanban-md --dir "$board" edit "$CARD_ID" --claim "$AGENT" --unblock --append-body "$answer_block"

# 2. Move back to todo. The card is currently in review (require_claim) so move
#    needs --claim. todo is not require_claim, but kanban-md doesn't auto-release;
#    we explicitly release afterwards so the next pick can claim freely.
kanban-md --dir "$board" move "$CARD_ID" todo --claim "$AGENT"

# 3. Release the claim so /kanban-auto's next pick can grab it.
kanban-md --dir "$board" edit "$CARD_ID" --release

printf 'Card %s unblocked and returned to todo.\n' "$CARD_ID"
