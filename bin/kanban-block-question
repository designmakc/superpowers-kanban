#!/usr/bin/env bash
# Move a card to review+blocked because the agent needs a human answer.
# Wraps `kanban-md handoff` with the conventions used by /kanban-auto.
#
# Usage:
#   kanban-block-question <card-id> "<one-line summary>" [--project-root DIR] [--agent NAME]
#
# The full question MUST already have been written into the card body by the
# subagent (via `kanban-md edit <id> --append-body ...`). This script only
# moves the card and records the summary as a handoff note.

set -euo pipefail

CARD_ID=""
SUMMARY=""
PROJECT_ROOT="."
AGENT=""

while [ $# -gt 0 ]; do
  case "$1" in
    --project-root) PROJECT_ROOT="$2"; shift 2 ;;
    --agent) AGENT="$2"; shift 2 ;;
    -h|--help) sed -n '2,14p' "$0"; exit 0 ;;
    *)
      if [ -z "$CARD_ID" ]; then CARD_ID="$1"
      elif [ -z "$SUMMARY" ]; then SUMMARY="$1"
      else printf 'Unexpected arg: %s\n' "$1" >&2; exit 2
      fi
      shift ;;
  esac
done

[ -n "$CARD_ID" ] || { printf 'card-id required\n' >&2; exit 2; }
[ -n "$SUMMARY" ] || { printf 'summary required\n' >&2; exit 2; }
command -v kanban-md >/dev/null 2>&1 || { printf 'kanban-md not on PATH\n' >&2; exit 1; }

script_dir="$(cd "$(dirname "$0")" && pwd)"
board=$("${script_dir}/kanban-active-board" --project-root "$PROJECT_ROOT")

if [ -z "$AGENT" ]; then
  config="${PROJECT_ROOT}/.superpowers-kanban/config.json"
  if [ -f "$config" ]; then
    AGENT=$(python3 -c "import json,sys; c=json.load(open(sys.argv[1])); print(c.get('agent_name') or 'claude')" "$config")
  else
    AGENT="claude"
  fi
fi

kanban-md --dir "$board" handoff "$CARD_ID" \
  --claim "$AGENT" \
  --block "Question for user: ${SUMMARY}" \
  --release \
  --note "Question (see card body): ${SUMMARY}" \
  --timestamp
