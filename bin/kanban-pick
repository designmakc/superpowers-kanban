#!/usr/bin/env bash
# Atomically pick the next todo card from the active plan board, claim it for
# this agent, and move it to in-progress. Emits the picked card as a JSON
# object on stdout (kanban-md's own --json format).
#
# Exit codes:
#   0 - a card was picked; JSON is on stdout
#   3 - no eligible cards (board empty or all blocked/claimed). stdout is empty.
#   1 - kanban-md or environment error. stderr explains.
#
# Usage:
#   kanban-pick [--project-root DIR] [--agent NAME]

set -euo pipefail

PROJECT_ROOT="."
AGENT=""

while [ $# -gt 0 ]; do
  case "$1" in
    --project-root) PROJECT_ROOT="$2"; shift 2 ;;
    --agent) AGENT="$2"; shift 2 ;;
    -h|--help) sed -n '2,15p' "$0"; exit 0 ;;
    *) printf 'Unknown arg: %s\n' "$1" >&2; exit 2 ;;
  esac
done

command -v kanban-md >/dev/null 2>&1 || { printf 'kanban-md not on PATH\n' >&2; exit 1; }

script_dir="$(cd "$(dirname "$0")" && pwd)"
board=$("${script_dir}/kanban-active-board" --project-root "$PROJECT_ROOT")

if [ -z "$AGENT" ]; then
  config="${PROJECT_ROOT}/.superpowers-kanban/config.json"
  if [ -f "$config" ]; then
    AGENT=$(python3 -c "import json,sys; c=json.load(open(sys.argv[1])); print(c.get('agent_name') or 'claude')" "$config")
  else
    AGENT="claude"
  fi
fi

set +e
out=$(kanban-md --dir "$board" --json pick --claim "$AGENT" --status todo --move in-progress 2>&1)
code=$?
set -e

# kanban-md emits a JSON error object on stdout when there's nothing to pick:
#   {"error": "no unblocked, unclaimed tasks found", "code": "NOTHING_TO_PICK"}
# and exits non-zero. Detect that specific shape and translate to exit code 3.
if [ $code -ne 0 ]; then
  err_code=$(printf '%s' "$out" | python3 -c "
import json, sys
try:
    d = json.loads(sys.stdin.read())
    print(d.get('code',''))
except Exception:
    print('')
" 2>/dev/null)
  if [ "$err_code" = "NOTHING_TO_PICK" ]; then
    exit 3
  fi
  printf '%s\n' "$out" >&2
  exit 1
fi

# kanban-md --json should emit a JSON object. Pass it through verbatim.
printf '%s\n' "$out"
