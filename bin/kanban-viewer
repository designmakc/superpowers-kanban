#!/usr/bin/env python3
"""Read-only web viewer for .superpowers-kanban/ boards.

A tiny single-file HTTP server using only the Python stdlib. Reads
board state fresh on every request (no caching) by shelling out to
`kanban-md --json list` so the parser stays correct as kanban-md
evolves.

Routes:
  /                          — index page listing all boards
  /board?id=<board-id>       — kanban view of one board
  /card?board=<id>&task=<n>  — card detail page
  /static/style.css          — stylesheet
  /api/boards                — JSON list of boards
  /api/board?id=<id>         — JSON tasks for one board

Board ids:
  roadmap, plans/<plan-id>

Usage:
  kanban-viewer [--project-root DIR] [--host HOST] [--port PORT]

Default host is 127.0.0.1, default port is 8765. Print the URL on
startup and serve until Ctrl-C.

This viewer does NOT modify any kanban data. To edit, use the kanban-md
CLI/TUI or the /kanban-resume slash command.
"""

from __future__ import annotations

import argparse
import html
import json
import os
import shutil
import subprocess
import sys
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path
from urllib.parse import urlparse, parse_qs


STATUS_ORDER = ["backlog", "todo", "in-progress", "review", "done", "archived"]


def die(msg: str) -> "NoReturn":
    print(f"[kanban-viewer] ERROR: {msg}", file=sys.stderr)
    sys.exit(1)


def kanban_json(board_dir: Path, args: list[str]) -> object:
    cmd = ["kanban-md", "--dir", str(board_dir), "--json"] + args
    res = subprocess.run(cmd, capture_output=True, text=True, stdin=subprocess.DEVNULL)
    if res.returncode != 0:
        return None
    try:
        return json.loads(res.stdout)
    except json.JSONDecodeError:
        return None


def list_tasks(board_dir: Path) -> list[dict]:
    data = kanban_json(board_dir, ["list"])
    if isinstance(data, list):
        return data
    if isinstance(data, dict):
        for k in ("tasks", "items", "results"):
            if isinstance(data.get(k), list):
                return data[k]
    return []


def show_task(board_dir: Path, task_id: int) -> dict | None:
    data = kanban_json(board_dir, ["show", str(task_id)])
    if isinstance(data, dict):
        return data.get("task", data)
    return None


def discover_boards(sp_dir: Path) -> list[tuple[str, Path]]:
    """Return [(board_id, board_dir), ...] for all valid kanban-md boards."""
    out: list[tuple[str, Path]] = []
    roadmap = sp_dir / "roadmap"
    if (roadmap / "config.yml").is_file():
        out.append(("roadmap", roadmap))
    plans = sp_dir / "plans"
    if plans.is_dir():
        for p in sorted(plans.iterdir()):
            if p.is_dir() and (p / "config.yml").is_file():
                out.append((f"plans/{p.name}", p))
    return out


def resolve_board(sp_dir: Path, board_id: str) -> Path | None:
    if board_id == "roadmap":
        candidate = sp_dir / "roadmap"
    elif board_id.startswith("plans/"):
        candidate = sp_dir / board_id
    else:
        return None
    return candidate if (candidate / "config.yml").is_file() else None


STYLE = """
:root {
  --bg: #0f1115;
  --panel: #161922;
  --panel-2: #1d212b;
  --border: #2a2f3d;
  --text: #e6e8ee;
  --text-dim: #9aa0aa;
  --accent: #7aa2f7;
  --green: #7cd181;
  --yellow: #e7c777;
  --red: #f7768e;
  --blocked: #ff5277;
}
* { box-sizing: border-box; }
body {
  margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  background: var(--bg); color: var(--text);
}
header {
  padding: 1rem 1.5rem; border-bottom: 1px solid var(--border);
  background: var(--panel); display: flex; align-items: center; gap: 1rem;
